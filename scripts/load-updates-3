async function main() {
  console.log(`Loading ${updates.length} new documents from deep research...\n`)
  for (const doc of updates) {
    await loadDocument(doc.text, doc.source, doc.category)
  }
  console.log('\nAll documents loaded successfully.')
}

main().catch(console.error)